# OpenAI-Compatible LLM Configuration (Optional - defaults to deterministic MockRepairLLM when unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Sandbox Execution Settings
SWE_SANDBOX_BACKEND=process
SWE_SANDBOX_TIMEOUT_SEC=15
SWE_MAX_REPAIR_TURNS=4
SWE_TOP_K_SYMBOLS=5
